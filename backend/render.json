{
  "services": [
    {
      "type": "web",
      "name": "studyquest-api",
      "runtime": "node",
      "region": "singapore",
      "plan": "free",
      "buildCommand": "npm install",
      "startCommand": "npm start",
      "healthCheckPath": "/api/health",
      "envVars": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "PORT",
          "value": "10000"
        },
        {
          "key": "DATABASE_URL",
          "sync": false
        },
        {
          "key": "JWT_SECRET",
          "generateValue": true
        },
        {
          "key": "KIMI_API_KEY",
          "sync": false
        },
        {
          "key": "FRONTEND_URL",
          "sync": false
        }
      ]
    }
  ]
}
