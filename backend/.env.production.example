# StudyQuest Backend - Production Environment Variables
# Copy this to .env.production and fill in actual values
# DO NOT commit .env.production to git!

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# DATABASE (Railway PostgreSQL)
# ============================================
# Railway auto-provides this when you add PostgreSQL
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# ============================================
# AUTHENTICATION
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# ============================================
# AI SERVICES
# ============================================
# Get from: https://platform.moonshot.cn/
KIMI_API_KEY=sk-your-kimi-api-key

# ============================================
# FRONTEND (CORS ALLOWLIST)
# ============================================
# Your frontend Railway URL (auto-generated or custom domain)
FRONTEND_URL=https://your-frontend.up.railway.app

# Optional: Custom domain if configured
CUSTOM_DOMAIN=https://studyquest.hk

# ============================================
# OPTIONAL: REDIS (for caching/sessions)
# ============================================
# Add via: railway add --plugin redis
# REDIS_URL=
